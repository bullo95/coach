# Copier en .env et adapter.
APP_ENV=dev
# Chemin du fichier SQLite (relatif à la racine du projet ou absolu)
DB_PATH=var/coach.sqlite
# Fuseau par défaut du compte
APP_TIMEZONE=Europe/Paris
# Notifications : lancer « php bin/vapid-keys.php mailto:adresse@exemple.fr » pour remplir ces trois lignes
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:...
